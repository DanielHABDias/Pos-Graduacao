# Copie este arquivo para .env e preencha somente os valores necessários.
CANVAS_BASE_URL=https://pucminas.instructure.com
CANVAS_ACCESS_TOKEN=
CANVAS_OUTPUT_DIR=./acervo

CANVAS_PER_PAGE=100
CANVAS_REQUEST_TIMEOUT_SECONDS=60
CANVAS_DOWNLOAD_CONCURRENCY=4
CANVAS_INCLUDE_CONCLUDED_COURSES=false
CANVAS_KEEP_SOURCE_HTML=true
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_PROVIDER=faster-whisper
WHISPER_MODEL=medium
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=auto

LOG_LEVEL=INFO
